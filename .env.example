# CommerceNest environment template
# Copy to `.env` (API/Docker) and optionally `apps/*/.env` for Vite apps.
#
# Environments:
#   development — single gateway port (default 8080), seed defaults, OTP returns `devCode`
#   test        — use isolated DB only (vitest starts embedded Postgres automatically)
#   production  — require strong JWT secrets, real DATABASE_URL, no seed passwords

# --- shared / API ---
NODE_ENV=development
PORT=4000
# Public edge port — open ONLY this in the browser
GATEWAY_PORT=8080

# PostgreSQL (never point tests at production)
# Local: `npm run dev` starts embedded Postgres, db push, seed, apps + gateway.
DATABASE_URL=postgresql://commercenest:commercenest@localhost:5432/commercenest?schema=public
POSTGRES_DB=commercenest
POSTGRES_USER=commercenest
POSTGRES_PASSWORD=commercenest

# Redis (optional locally — leave empty to use in-memory; required for multi-instance)
REDIS_URL=

# JWT secrets (generate strong random strings for production; min 32 chars)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# Domains & CORS
# Local gateway uses *.localhost (auto-resolved by browsers).
PLATFORM_DOMAIN=commercenest.local
APP_BASE_DOMAIN=commercenest.local
CORS_ORIGINS=http://localhost:8080,http://admin.localhost:8080,http://app.localhost:8080,http://techworld-bd.localhost:8080,http://rahim-mobile.localhost:8080,http://urban-threads.localhost:8080
CORS_ORIGIN=http://localhost:8080,http://admin.localhost:8080,http://app.localhost:8080,http://techworld-bd.localhost:8080
CORS_ALLOW_LOCALHOST_SUBDOMAINS=true

# Cloudinary (optional — media URL-register works without credentials)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS provider (optional — without this, production OTP cannot be delivered)
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=

LOG_LEVEL=info

# --- Frontend (Vite build-time) ---
# Empty API base = same-origin `/api` through the gateway (recommended).
VITE_API_BASE_URL=
# Leave empty so storefront resolves tenant from subdomain (techworld-bd.localhost).
VITE_STORE_SLUG=
VITE_STORE_DASHBOARD_URL=http://app.localhost:8080

# Marketing homepage login targets (optional — auto-derived from host when empty)
VITE_ADMIN_URL=http://admin.localhost:8080
VITE_APP_URL=http://app.localhost:8080
# Optional — only shown when set
VITE_SUPPORT_EMAIL=

# Bootstrap Master Admin (seed only — change before any shared environment)
SEED_ADMIN_EMAIL=admin@commercenest.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Platform Owner
